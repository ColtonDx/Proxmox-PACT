# Proxmox-PACT Answerfile Sample
#
# This file can be sourced by build.sh to load all configuration values.
# Copy this file to .env.local and modify the values, then run:
#   ./Scripts/build.sh
#
# All values are OPTIONAL. Only set the ones you want to override.
# Values provided via CLI arguments take precedence over this file.

# ============================================================================
# PROXMOX CONNECTION SETTINGS
# ============================================================================
PROXMOX_HOST="pve.local"                          # Proxmox hostname or IP address
PROXMOX_TARGET_NODE="pve"                          # Proxmox cluster node name
PROXMOX_SSH_USER="root"                           # SSH username for Proxmox
PROXMOX_SSH_PASSWORD="your_password"              # SSH password (if using password auth)
#SSH_PRIVATE_KEY_PATH="/path/to/key"              # Path to SSH private key (if using key auth)
PROXMOX_STORAGE="local-lvm"                       # Storage pool for templates

# ============================================================================
# TEMPLATE CREATION SETTINGS
# ============================================================================
VMID_BASE=800                                     # Base VMID for templates (default: 800)

# Which distros to build - choose ONE of the following methods:
#
# Method 1: Use BUILD_DISTROS with comma-separated names (preferred)
# Options: debian, ubuntu, fedora, or individual names like debian12, fedora43
#   - debian: all Debian versions (11, 12, 13)
#   - ubuntu: all Ubuntu versions (22.04, 24.04, 26.04)
#   - fedora: all Fedora versions (43, 44)
#   - all: all available distros
BUILD_DISTROS="debian12,ubuntu2404"

# ============================================================================
# TEMPLATE CREATION METHOD (Choose one)
# ============================================================================
# Use SSH to Proxmox (default: true)
PROXMOX_IS_REMOTE=true
# Run locally on Proxmox host without SSH (default: false)
# Set PROXMOX_IS_REMOTE=false to run locally

# ============================================================================
# PACKER CUSTOMIZATION SETTINGS
# ============================================================================
# Enable Packer customization phase (default: false)
RUN_PACKER=false
# Proxmox target node for Packer builds (default: pve)
PROXMOX_TARGET_NODE="pve"
# Proxmox API Token ID (required if RUN_PACKER=true)
PACKER_TOKEN_ID="user@pam!packer"
# Proxmox API Token Secret (required if RUN_PACKER=true)
PACKER_TOKEN_SECRET="your_api_token_secret"
# Path or URL to custom Packer template (optional)
#CUSTOM_PACKERFILE="/path/to/custom.pkr.hcl"
# Path or URL to custom Ansible playbook (optional)
#CUSTOM_ANSIBLE_PLAYBOOK="/path/to/playbook.yml"
# Path or URL to custom Ansible variables file (optional)
#CUSTOM_ANSIBLE_VARFILE="/path/to/vars.yml"

# ============================================================================
# CLOUD-INIT CUSTOMIZATION (optional)
# ============================================================================
# Bake a default username/password/SSH key into the templates (default: false).
# Without this, templates ship with an empty Cloud-Init drive and you set these
# per-VM from the Proxmox UI when cloning. At least one of the values below is
# required when this is true.
CUSTOMIZE_CLOUDINIT=false
#CLOUDINIT_USER="ubuntu"
# WARNING: stored in PLAINTEXT in each VM's Proxmox config (qm config) - prefer SSH keys.
#CLOUDINIT_PASSWORD="your_password"
#CLOUDINIT_SSH_KEYS="ssh-ed25519 AAAA... you@example.com"
# Path to a file of SSH public keys, one per line (overrides CLOUDINIT_SSH_KEYS above)
#CLOUDINIT_SSH_KEY_FILE="/path/to/authorized_keys"

# ============================================================================
# BUILD OPTIONS
# ============================================================================
# Delete existing VMs before building (default: false)
REBUILD_TEMPLATES=false
