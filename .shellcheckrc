# ShellCheck configuration for Proxmox-P.A.C.T.
#
# The build scripts intentionally use a few patterns ShellCheck flags by
# default. These are deliberate for this codebase, so they are disabled
# project-wide; everything else stays enabled to catch real issues.
#
#   SC1090/SC1091 - dynamic `source` of the answerfile / sourcing /etc/os-release
#   SC2086        - deliberate word-splitting of built-up argument lists
#                   (e.g. $PROXMOX_SCRIPT_ARGS, $PACKAGES_TO_INSTALL)
#   SC2076        - literal (non-regex) matching inside [[ .. =~ " $x " ]] guards
#   SC2087        - heredocs to ssh expand variables client-side on purpose
#   SC2064        - trap strings expand at definition time on purpose
#   SC2181        - existing style checks $? after a command
disable=SC1090
disable=SC1091
disable=SC2086
disable=SC2076
disable=SC2087
disable=SC2064
disable=SC2181
