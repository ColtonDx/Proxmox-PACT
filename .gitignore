# Packer binary + release archives (build.sh installs Packer)
packer
packer_*_linux_amd64.zip

# Build working directories
workingdir/
pact_build_*/

# Local answerfile (may contain SSH passwords / API tokens)
.env.local

# SSH keys from interactive Cloud-Init setup. These default to ~/.ssh, but the prompt
# accepts any path, so guard against a private key being committed from the repo root.
pact-*
*.ppk
