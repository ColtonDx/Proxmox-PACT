# Example answerfile: running directly ON the Proxmox host (no SSH)
#
# Copy to the repo root as .env.local and run:  ./Scripts/build.sh
# build.sh also auto-detects when it is running on a Proxmox host, but setting
# PROXMOX_IS_REMOTE=false makes the intent explicit.
#
# Note: enabling Packer here installs Packer/Ansible on the Proxmox host itself,
# which is not recommended. Keep RUN_PACKER=false for local runs unless you
# specifically want those binaries on the host.

PROXMOX_IS_REMOTE=false             # Run locally, no SSH connection
PROXMOX_STORAGE="local-lvm"

VMID_BASE=800
BUILD_DISTROS="debian12,fedora44"
RUN_PACKER=false
