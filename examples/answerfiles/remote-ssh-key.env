# Example answerfile: remote Proxmox over SSH with key-based auth
#
# Copy to the repo root as .env.local and edit, then run:  ./Scripts/build.sh
# Leave PROXMOX_SSH_PASSWORD unset when using a private key.

PROXMOX_HOST="pve.local"
PROXMOX_SSH_USER="root"
SSH_PRIVATE_KEY_PATH="/home/you/.ssh/id_ed25519"   # Path to your private key
PROXMOX_STORAGE="local-lvm"
PROXMOX_IS_REMOTE=true

VMID_BASE=800
BUILD_DISTROS="all"
RUN_PACKER=false
