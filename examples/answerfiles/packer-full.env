# Example answerfile: full run with Packer customization + a custom playbook
#
# Copy to the repo root as .env.local and edit, then run:  ./Scripts/build.sh
# Packer needs a Proxmox API token (create one under Datacenter > Permissions >
# API Tokens). CUSTOM_ANSIBLE_* accept either a local path or an https:// URL.

PROXMOX_HOST="pve.local"
PROXMOX_TARGET_NODE="pve"           # Node Packer targets (default: pve)
PROXMOX_SSH_USER="root"
PROXMOX_SSH_PASSWORD="changeme"
PROXMOX_STORAGE="local-lvm"
PROXMOX_IS_REMOTE=true

VMID_BASE=800
BUILD_DISTROS="all"

RUN_PACKER=true
PACKER_TOKEN_ID="packer@pam!packer"           # user@realm!token-name
PACKER_TOKEN_SECRET="00000000-0000-0000-0000-000000000000"

# Optional: override the default customization with your own files
CUSTOM_ANSIBLE_PLAYBOOK="./examples/playbooks/custom-playbook.yml"
CUSTOM_ANSIBLE_VARFILE="./examples/playbooks/custom-vars.yml"
#CUSTOM_PACKERFILE="./Packer/Templates/universal.pkr.hcl"

REBUILD_TEMPLATES=false             # true = destroy existing VMIDs first
