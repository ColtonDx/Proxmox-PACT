# Example answerfile: remote Proxmox over SSH with password auth
#
# Copy to the repo root as .env.local and edit, then run:  ./Scripts/build.sh
# (All values are optional; CLI arguments override anything set here.)

PROXMOX_HOST="pve.local"            # Proxmox hostname or IP
PROXMOX_SSH_USER="root"             # SSH user on the Proxmox node
PROXMOX_SSH_PASSWORD="changeme"     # SSH password (placeholder - replace)
PROXMOX_STORAGE="local-lvm"         # Storage pool for the templates
PROXMOX_IS_REMOTE=true              # Connect over SSH (the default)

VMID_BASE=800                       # Templates land at 800 + distro offset
BUILD_DISTROS="debian12,ubuntu2404" # all | debian | ubuntu | fedora | names
RUN_PACKER=false                    # Base templates only (no Packer phase)
